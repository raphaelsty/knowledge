{$DOMAIN:localhost} {
	# Knowledge API — all backend routes.
	# Caddy's `handle /indices/*` matches paths like /indices/{name}/...
	# but NOT the bare `/indices` (no trailing content) — so we also
	# need an exact-path handle, otherwise `POST /indices` (used to
	# declare a new index) falls through to the static file server
	# below and returns 405.
	handle /indices {
		reverse_proxy knowledge-api:8080
	}
	handle /indices/* {
		reverse_proxy knowledge-api:8080
	}

	handle /api/* {
		reverse_proxy knowledge-api:8080
	}

	handle /auth/* {
		reverse_proxy knowledge-api:8080
	}

	handle /mcp {
		reverse_proxy knowledge-api:8080
	}

	handle /encode {
		reverse_proxy knowledge-api:8080
	}

	handle /health {
		reverse_proxy knowledge-api:8080
	}

	handle /events {
		reverse_proxy knowledge-api:8080
	}

	handle /stats/* {
		reverse_proxy knowledge-api:8080
	}

	# Static frontend files. Cache-Control headers are layered
	# inside the handle block so Caddy actually emits them — the
	# outer site-level header directive is skipped once a matching
	# `handle` swallows the request. Layering:
	#
	#   * Versioned assets (CSS / JS / fonts) get a generous browser
	#     cache with `stale-while-revalidate` so a return visit
	#     never blocks on a fetch — the browser uses the cached
	#     copy and revalidates in the background.
	#   * Images get a long browser cache (they rarely change).
	#   * HTML stays no-cache so a deploy is visible on next
	#     navigation; the index page itself is small.
	handle {
		root * /web
		@static_assets path *.css *.js *.woff *.woff2 *.ttf *.otf
		header @static_assets Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
		@static_images path *.png *.jpg *.jpeg *.gif *.webp *.svg *.ico
		header @static_images Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
		# HTML / SPA routes — `path *.html /` only catches literal
		# `.html` requests and `/`; the SPA paths `/search`,
		# `/profile`, `/admin` and `/<personality-slug>` are served
		# via try_files but their request path stays extensionless,
		# so we match them with a regex. no-cache keeps deploys
		# propagating on the next navigation.
		@static_html path_regexp ^/?$|^/[A-Za-z0-9_-]+/?$|^/.+\.html$
		header @static_html Cache-Control "no-cache"
		try_files {path} {path}.html /index.html
		file_server
	}
}

# Ops UIs — Portainer (Docker management) and Dozzle (live logs).
# Both reach their containers via the shared `knowledge_default`
# network. Containers bind only to localhost on the host so the
# only public entry point is Caddy's TLS termination.
portainer.{$DOMAIN:localhost} {
	reverse_proxy portainer:9000
}

logs.{$DOMAIN:localhost} {
	reverse_proxy dozzle:8080
}
